{
  "id": "iracing",
  "name": "iRacing",
  "category": "simracing",
  "icon": "🏎️",
  "color": "#1E2A78",
  "description": "Lancement de iRacing et page de commandes prête à l'emploi.",
  "requires": [
    "simracing"
  ],
  "notes": [
    "Ces touches utilisent le schéma SimDeck (F13 à F24, combinées avec Ctrl / Maj / Alt) : des touches absentes des claviers, donc sans conflit. Associez-les une fois dans les contrôles du jeu (cliquez sur l'action dans le jeu puis appuyez sur la touche SimDeck avec « ▶ Tester »), ou remplacez-les par vos propres touches.",
    "Les commandes de stand passent directement par le SDK iRacing : rien à associer dans le jeu."
  ],
  "autoSwitch": {
    "processName": "iRacingSim64DX11.exe"
  },
  "presets": [
    {
      "id": "launch",
      "label": "Lancer iRacing",
      "icon": "🏎️",
      "color": "#1E2A78",
      "description": "Ouvre l'interface iRacing.",
      "actions": [
        {
          "type": "launch",
          "path": "C:\\Program Files (x86)\\iRacing\\ui\\iRacingUI.exe",
          "skipIfRunning": "iRacingUI.exe"
        }
      ],
      "activeWhen": {
        "type": "processRunning",
        "processName": "iRacingSim64DX11.exe"
      },
      "activeStyle": {
        "color": "#43A047",
        "label": "iRacing lancé"
      }
    },
    {
      "id": "quit",
      "label": "Quitter le jeu",
      "icon": "⏻",
      "color": "#424242",
      "description": "Appui long pour fermer le jeu.",
      "longPressActions": [
        {
          "type": "kill",
          "processName": "iRacingSim64DX11.exe"
        }
      ],
      "actions": []
    },
    {
      "id": "fuel_add",
      "label": "Essence +10 L",
      "icon": "⛽",
      "color": "#F57C00",
      "actions": [
        {
          "type": "iracingPit",
          "command": "fuel",
          "value": 10
        }
      ]
    },
    {
      "id": "fuel_none",
      "label": "Pas d'essence",
      "icon": "⛽",
      "color": "#424242",
      "actions": [
        {
          "type": "iracingPit",
          "command": "clearFuel"
        }
      ]
    },
    {
      "id": "tires_all",
      "label": "4 pneus",
      "icon": "🛞",
      "color": "#F57C00",
      "actions": [
        {
          "type": "iracingPit",
          "command": "lf",
          "value": 0
        },
        {
          "type": "iracingPit",
          "command": "rf",
          "value": 0
        },
        {
          "type": "iracingPit",
          "command": "lr",
          "value": 0
        },
        {
          "type": "iracingPit",
          "command": "rr",
          "value": 0
        }
      ]
    },
    {
      "id": "tires_none",
      "label": "Sans pneus",
      "icon": "🚫",
      "color": "#424242",
      "actions": [
        {
          "type": "iracingPit",
          "command": "clearTires"
        }
      ]
    },
    {
      "id": "fast_repair",
      "label": "Fast repair",
      "icon": "🔧",
      "color": "#F57C00",
      "actions": [
        {
          "type": "iracingPit",
          "command": "fastRepair"
        }
      ]
    },
    {
      "id": "windshield",
      "label": "Pare-brise",
      "icon": "🧽",
      "color": "#F57C00",
      "actions": [
        {
          "type": "iracingPit",
          "command": "windshield"
        }
      ]
    },
    {
      "id": "pit_clear",
      "label": "Annuler stand",
      "icon": "✖",
      "color": "#424242",
      "actions": [
        {
          "type": "iracingPit",
          "command": "clear"
        }
      ]
    },
    {
      "id": "chat_1",
      "label": "Macro chat 1",
      "icon": "💬",
      "color": "#546E7A",
      "actions": [
        {
          "type": "iracingChat",
          "mode": "macro",
          "macro": 1
        }
      ]
    }
  ],
  "boards": [
    {
      "id": "main",
      "name": "iRacing",
      "rows": 3,
      "cols": 5,
      "buttons": [
        {
          "preset": "simracing/pit_limiter",
          "row": 0,
          "col": 0
        },
        {
          "preset": "fuel_add",
          "row": 0,
          "col": 1
        },
        {
          "preset": "tires_all",
          "row": 0,
          "col": 2
        },
        {
          "preset": "fast_repair",
          "row": 0,
          "col": 3
        },
        {
          "preset": "pit_clear",
          "row": 0,
          "col": 4
        },
        {
          "preset": "simracing/abs_down",
          "row": 1,
          "col": 0
        },
        {
          "preset": "simracing/abs_up",
          "row": 1,
          "col": 1
        },
        {
          "preset": "simracing/tc_down",
          "row": 1,
          "col": 2
        },
        {
          "preset": "simracing/tc_up",
          "row": 1,
          "col": 3
        },
        {
          "preset": "windshield",
          "row": 1,
          "col": 4
        },
        {
          "preset": "simracing/bias_rear",
          "row": 2,
          "col": 0
        },
        {
          "preset": "simracing/bias_fwd",
          "row": 2,
          "col": 1
        },
        {
          "preset": "simracing/headlights",
          "row": 2,
          "col": 2
        },
        {
          "preset": "chat_1",
          "row": 2,
          "col": 3
        },
        {
          "preset": "quit",
          "row": 2,
          "col": 4
        }
      ]
    }
  ],
  "version": "1.0.0",
  "author": "SimDeck",
  "minAppVersion": "1.1.0"
}
