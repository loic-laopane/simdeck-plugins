      "actions": [
        {
          "type": "hotkey",
          "keys": [
            "win",
            "shift",
            "s"
          ],
          "mode": "press",
          "holdMs": 60
        }
      ]
    },
    {
      "id": "clipboard",
      "label": "Presse-papiers",
