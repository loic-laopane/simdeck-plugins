{
  "id": "windows",
  "name": "Windows",
  "category": "windows",
  "icon": "🪟",
  "color": "#0078D4",
  "default": true,
  "description": "Son, multimédia, explorateur, captures, paramètres, verrouillage, veille, redémarrage et arrêt du PC.",
  "notes": [
    "Veille, redémarrage et arrêt ne se déclenchent que sur un appui long, pour éviter les accidents."
  ],
  "presets": [
    {
      "id": "vol_up",
      "label": "Volume +",
      "icon": "🔊",
      "color": "#0078D4",
      "actions": [
        {
          "type": "hotkey",
          "keys": [
            "volumeup"
          ],
          "mode": "press",
          "holdMs": 60
        }
      ]
    },
    {
      "id": "vol_down",
      "label": "Volume −",
      "icon": "🔉",
      "color": "#0078D4",
      "actions": [
        {
          "type": "hotkey",
          "keys": [
            "volumedown"
          ],
          "mode": "press",
          "holdMs": 60
        }
      ]
    },
    {
      "id": "mute",
      "label": "Muet",
      "icon": "🔇",
      "color": "#0078D4",
      "actions": [
        {
          "type": "hotkey",
          "keys": [
            "volumemute"
          ],
          "mode": "press",
          "holdMs": 60
        }
      ]
    },
    {
      "id": "play_pause",
      "label": "Lecture / pause",
      "icon": "⏯",
      "color": "#0078D4",
      "actions": [
        {
          "type": "hotkey",
          "keys": [
            "mediaplaypause"
          ],
          "mode": "press",
          "holdMs": 60
        }
      ]
