    {
      "id": "settings",
      "label": "Paramètres",
      "icon": "⚙️",
      "color": "#546E7A",
      "actions": [
        {
          "type": "open",
          "target": "ms-settings:"
        }
      ]
    },
    {
      "id": "display",
      "label": "Affichage",
      "icon": "🖵",
      "color": "#546E7A",
      "actions": [
        {
          "type": "open",
          "target": "ms-settings:display"
        }
      ]
    },
    {
      "id": "lock",
      "label": "Verrouiller",
      "icon": "🔒",
      "color": "#424242",
      "actions": [
        {
          "type": "command",
          "command": "rundll32.exe user32.dll,LockWorkStation"
        }
      ]
    },
    {
      "id": "sleep",
      "label": "Veille",
      "icon": "🌙",
      "color": "#424242",
      "description": "Appui long pour mettre le PC en veille.",
      "actions": [],
      "longPressActions": [
        {
          "type": "command",
          "command": "rundll32.exe powrprof.dll,SetSuspendState 0,1,0"
        }
      ]
    },
    {
      "id": "restart",
      "label": "Redémarrer",
      "icon": "🔄",
      "color": "#B71C1C",
      "description": "Appui long pour redémarrer le PC.",
      "actions": [],
      "longPressActions": [
        {
          "type": "command",
          "command": "shutdown /r /t 0"
        }
      ]
    },
    {
      "id": "shutdown",
      "label": "Éteindre le PC",
      "icon": "⏻",
      "color": "#B71C1C",
      "description": "Appui long pour éteindre le PC.",
      "actions": [],
      "longPressActions": [
        {
          "type": "command",
          "command": "shutdown /s /t 0"
        }
      ]
    }
  ],
