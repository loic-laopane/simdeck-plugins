          ],
          "mode": "press",
          "holdMs": 60
        }
      ]
    },
    {
      "id": "prev",
      "label": "Piste précédente",
      "icon": "⏮",
      "color": "#0078D4",
      "actions": [
        {
          "type": "hotkey",
          "keys": [
            "mediaprev"
          ],
          "mode": "press",
          "holdMs": 60
        }
      ]
    },
    {
      "id": "sound_settings",
      "label": "Sortie audio",
