{
  "id": "obs",
  "name": "OBS Studio",
  "category": "streaming",
  "icon": "🎥",
  "color": "#302E31",
  "description": "Board complet pour OBS : stream, enregistrement, replay, scènes, micro, mode studio.",
  "notes": [
    "Associez chaque touche dans OBS : Fichier → Paramètres → Raccourcis clavier (cliquez dans le champ puis appuyez sur « ▶ Tester » dans SimDeck)."
  ],
  "presets": [
    {
      "id": "launch",
      "label": "Lancer OBS",
      "icon": "🎥",
      "color": "#302E31",
      "actions": [
        {
          "type": "launch",
          "path": "C:\\Program Files\\obs-studio\\bin\\64bit\\obs64.exe",
          "skipIfRunning": "obs64.exe"
        }
      ],
      "activeWhen": {
        "type": "processRunning",
        "processName": "obs64.exe"
      },
      "activeStyle": {
        "color": "#43A047"
      }
    },
    {
      "id": "stream_start",
      "label": "Démarrer le stream",
      "icon": "🔴",
      "color": "#E53935",
      "actions": [
        {
          "type": "hotkey",
          "keys": [
            "ctrl",
            "alt",
            "f13"
          ],
          "mode": "press",
          "holdMs": 60
        }
      ]
    },
    {
      "id": "stream_stop",
      "label": "Arrêter le stream",
      "icon": "⏹",
      "color": "#424242",
      "actions": [
